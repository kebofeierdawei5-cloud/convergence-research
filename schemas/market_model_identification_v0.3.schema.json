{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://iios.local/schemas/market_model_identification_v0.3.schema.json",
  "title":"IIOS Market Model Identification v0.3",
  "type":"object",
  "required":["cutoff_date","current_observation_id","candidates","observations","identifiability","stability","method"],
  "properties":{
    "cutoff_date":{"type":"string","format":"date"},
    "current_observation_id":{"type":"string","minLength":1},
    "method":{"const":"model_specific_inverse_v0.3"},
    "candidates":{"type":"array","minItems":1},
    "observations":{"type":"array","minItems":1},
    "identifiability":{"type":"object"},
    "stability":{
      "type":"object",
      "properties":{"assessment_scope":{"const":"IDENTIFICATION_ONLY"}}
    }
  },
  "additionalProperties":false
}