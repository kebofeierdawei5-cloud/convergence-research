{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iios.local/schemas/llm-semantic-artifact-0.1.schema.json",
  "title": "IIOS Semantic Artifact Common Envelope v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id", "artifact_type", "schema_version", "case_id", "market", "symbol", "company",
    "cutoff_date", "producer_type", "producer_id", "producer_version", "policy_version",
    "input_refs", "input_hashes", "output", "facts", "inferences", "assumptions",
    "uncertainties", "decision_relevance", "created_at", "artifact_hash"
  ],
  "properties": {
    "artifact_id": {"type":"string","minLength":1},
    "artifact_type": {"enum":["REALITY_INTERPRETATION","TRUST_ASSESSMENT","QUALITY_ASSESSMENT","THESIS_ASSESSMENT","VALUE_DRIVER_ASSESSMENT","INDEPENDENT_FORECAST_REASONING","VALUATION_PROPOSAL","MIE_INTERPRETATION","RISK_ASSESSMENT","POSITIONING_ASSESSMENT"]},
    "schema_version": {"const":"IIOS-LLM-SEMANTIC-ARTIFACT-0.1"},
    "case_id": {"type":"string","minLength":1},
    "market": {"enum":["CN-A","HK"]},
    "symbol": {"type":"string","minLength":1},
    "company": {"type":"string","minLength":1},
    "cutoff_date": {"type":"string","format":"date"},
    "producer_type": {"enum":["LLM_SEMANTIC_PRODUCER","HUMAN_EXPERT_ADJUDICATION"]},
    "producer_id": {"type":"string","minLength":1},
    "producer_version": {"type":"string","minLength":1},
    "policy_version": {"type":"string","minLength":1},
    "input_refs": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "input_hashes": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "output": {"type":"object"},
    "facts": {"type":"array","items":{"type":"object"}},
    "inferences": {"type":"array","items":{"type":"object"}},
    "assumptions": {"type":"array","items":{"type":"object"}},
    "uncertainties": {"type":"array","items":{"type":"object"}},
    "decision_relevance": {"type":"string","minLength":1},
    "created_at": {"type":"string","format":"date-time"},
    "artifact_hash": {"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
