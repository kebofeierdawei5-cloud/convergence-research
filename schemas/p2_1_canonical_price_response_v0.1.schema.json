{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iios.local/schemas/p2-1-canonical-price-response-0.1.schema.json",
  "title": "IIOS P2.1 Canonical Model-Specific Price Response v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "response_id","status","response_schema","response_version","case_id","cutoff_date",
    "snapshot_hash","mie_set_hash","provenance_hash","model_id","market_model","expectation_id",
    "representation","qualification","price_observation_id","reference_price","candidate_price",
    "response_form","formula_id","formula_version","variable_id","unit","basis",
    "comparison_direction","reference_value_low","reference_value_high","candidate_value_low",
    "candidate_value_high","affine_slope","affine_intercept","affine_slope_high",
    "affine_intercept_high","assumption_fingerprint","evidence_ids","reason","gap_absolute",
    "gap_relative","gap_positive","expectation_gap_price_boundary","price_constraint_type",
    "independent_value","independent_forecast_id","independent_forecast_version",
    "independent_forecast_model_version","independent_evidence_ids"
  ],
  "properties": {
    "response_id": {"type":"string","minLength":1},
    "status": {"enum":["PASS","NON_POSITIVE"]},
    "response_schema": {"const":"IIOS-P2.1-PRICE-RESPONSE-REPLAY-0.1"},
    "response_version": {"const":"IIOS-P2.1-CANONICAL-PRICE-RESPONSE-0.1"},
    "case_id": {"type":"string","minLength":1},
    "cutoff_date": {"type":"string","format":"date"},
    "snapshot_hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "mie_set_hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "provenance_hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "model_id": {"type":"string","minLength":1},
    "market_model": {"enum":["ev_ebitda","dcf","ddm","sotp","rnpv"]},
    "expectation_id": {"type":"string","minLength":1},
    "representation": {"type":"string","minLength":1},
    "qualification": {"enum":["DECISION_GRADE","CONDITIONAL_ONLY"]},
    "price_observation_id": {"type":"string","minLength":1},
    "reference_price": {"type":"string"},
    "candidate_price": {"type":"string"},
    "response_form": {"enum":["AFFINE","AFFINE_RANGE"]},
    "formula_id": {"type":"string","minLength":1},
    "formula_version": {"const":"IIOS-P2.1-CANONICAL-PRICE-RESPONSE-0.1"},
    "variable_id": {"type":"string","minLength":1},
    "unit": {"type":"string","minLength":1},
    "basis": {"type":"string","minLength":1},
    "comparison_direction": {"enum":["HIGHER_IS_BETTER","LOWER_IS_BETTER"]},
    "reference_value_low": {"type":"string"},
    "reference_value_high": {"type":"string"},
    "candidate_value_low": {"type":"string"},
    "candidate_value_high": {"type":"string"},
    "affine_slope": {"type":"string"},
    "affine_intercept": {"type":"string"},
    "affine_slope_high": {"type":"string"},
    "affine_intercept_high": {"type":"string"},
    "assumption_fingerprint": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "evidence_ids": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "reason": {"type":"string","minLength":1},
    "gap_absolute": {"type":"string"},
    "gap_relative": {"type":"string"},
    "gap_positive": {"type":"boolean"},
    "expectation_gap_price_boundary": {"type":"string"},
    "price_constraint_type": {"enum":["UPPER_BOUND_STRICT","LOWER_BOUND_STRICT"]},
    "independent_value": {"type":"string"},
    "independent_forecast_id": {"type":"string","minLength":1},
    "independent_forecast_version": {"type":"string","minLength":1},
    "independent_forecast_model_version": {"type":"string","minLength":1},
    "independent_evidence_ids": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}