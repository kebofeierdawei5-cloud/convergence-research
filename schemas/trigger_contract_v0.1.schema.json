{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iios.local/schemas/trigger-contract-0.1.schema.json",
  "title": "IIOS Trigger Contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "trigger_id",
    "decision_id",
    "decision_series_id",
    "revision",
    "decision_revision_hash",
    "case_id",
    "decision_cutoff_date",
    "role",
    "metric_id",
    "operator",
    "target",
    "unit",
    "evidence_ids",
    "enabled",
    "policy_effect",
    "trigger_hash"
  ],
  "properties": {
    "contract_version": {
      "const": "IIOS-TRIGGER-CONTRACT-0.1"
    },
    "trigger_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_series_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "decision_revision_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_cutoff_date": {
      "type": "string",
      "format": "date"
    },
    "role": {
      "enum": [
        "THESIS_BREAK",
        "MONITORING",
        "VALIDATION"
      ]
    },
    "metric_id": {
      "type": "string",
      "minLength": 1
    },
    "operator": {
      "enum": [
        "LT",
        "LTE",
        "GT",
        "GTE",
        "EQ",
        "NE",
        "CHANGED",
        "UNCHANGED",
        "MISSING",
        "PRESENT"
      ]
    },
    "target": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "enabled": {
      "type": "boolean"
    },
    "policy_effect": {
      "const": "NO_DIRECT_DECISION_PRECEDENCE_CHANGE"
    },
    "trigger_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
