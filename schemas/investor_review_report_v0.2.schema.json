{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iios.local/schemas/investor-review-report-0.2.schema.json",
  "title": "IIOS Investor Review Report v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_version","generated_at","publication_id","publication_hash","decision_id","revision","case_id","cutoff_date","language","machine_report_hash","human_report_hash","machine_report","markdown","report_id","report_hash"],
  "properties": {
    "report_version": {"const": "IIOS-INVESTOR-REVIEW-0.2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "publication_id": {"type": "string", "minLength": 1},
    "publication_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "case_id": {"type": "string", "minLength": 1},
    "cutoff_date": {"type": "string", "format": "date"},
    "language": {"const": "zh-CN"},
    "machine_report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "human_report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "machine_report": {
      "type": "object",
      "additionalProperties": true,
      "required": ["machine_report_hash","semantic_surface"],
      "properties": {
        "semantic_surface": {
          "type": "object",
          "additionalProperties": true,
          "required": ["human_auditability"]
        }
      }
    },
    "markdown": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
