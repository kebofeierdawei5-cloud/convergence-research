          "properties": {
            "forecast_id": {
              "type": "string",
              "minLength": 1
            },
            "admission_record_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "canonical_valuation_ref": {
          "$ref": "#/$defs/canonicalAdmissionReference"
        },
        "scenarios": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bear",
            "base",
            "bull"
          ],
          "properties": {
            "bear": {
              "$ref": "#/$defs/scenario"
            },
            "base": {
              "$ref": "#/$defs/scenario"
            },
            "bull": {
              "$ref": "#/$defs/scenario"
            }
          }
        }
      }
