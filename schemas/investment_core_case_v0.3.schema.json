        "admission_record_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "canonical_admission_refs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "REALITY",
            "QUALITY",
            "VALUE_DRIVER",
            "VALUATION",
            "FORECAST"
          ],
          "properties": {
            "REALITY": {"$ref": "#/$defs/canonicalAdmissionReference"},
            "QUALITY": {"$ref": "#/$defs/canonicalAdmissionReference"},
            "VALUE_DRIVER": {"$ref": "#/$defs/canonicalAdmissionReference"},
            "VALUATION": {"$ref": "#/$defs/canonicalAdmissionReference"},
            "FORECAST": {"$ref": "#/$defs/canonicalAdmissionReference"}
