{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iios.local/schemas/investment-core-case-0.3.schema.json",
  "title": "IIOS Investment Core Case v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "case_id",
    "market",
    "symbol",
    "company",
    "as_of_date",
    "cutoff_date",
    "current_price_observation",
    "company_evidence_manifest",
    "trust",
    "reality",
    "forecast",
    "valuation",
    "risk",
    "portfolio",
    "thesis",
    "decision_upstream_admission",
    "return_gate"
  ],
  "properties": {
    "contract_version": {
      "const": "IIOS-INVESTMENT-CORE-0.3"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "market": {
      "type": "string",
      "minLength": 1
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "company": {
      "type": "string",
      "minLength": 1
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "cutoff_date": {
      "type": "string",
      "format": "date"
    },
    "current_price_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "price",
        "price_observation_id",
        "currency",
        "observed_at",
        "known_at",
        "source",
        "adjustment_semantics",
        "price_observation_admission_hash"
      ],
      "properties": {
        "price": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "price_observation_id": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "minLength": 1
        },
        "known_at": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "adjustment_semantics": {
          "enum": [
            "UNADJUSTED",
            "SPLIT_ADJUSTED",
            "DIVIDEND_ADJUSTED",
            "TOTAL_RETURN_ADJUSTED",
            "OTHER_EXPLICIT"
          ]
        },
        "adjustment_note": {
          "type": "string"
        },
        "price_observation_admission_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "company_evidence_manifest": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "manifest_id"
      ],
      "properties": {
        "manifest_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "REVALIDATION",
            "FAIL",
            "UNKNOWN"
          ]
        }
      }
    },
    "reality": {
      "type": "object"
    },
    "forecast": {
      "type": "object"
    },
    "valuation": {
      "type": "object"
    },
    "risk": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "max_loss_pct",
        "thesis_breaks",
        "evidence_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "max_loss_pct": {
          "type": [
            "string",
            "number"
          ],
          "minimum": 0,
          "exclusiveMaximum": 100
        },
        "thesis_breaks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "portfolio": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "position_pct",
        "constraint_status",
        "can_add"
      ],
      "properties": {
        "position_pct": {
          "type": [
            "string",
            "number"
          ]
        },
        "constraint_status": {
          "enum": [
            "PASS",
            "BLOCKED",
            "UNKNOWN"
          ]
        },
        "can_add": {
          "type": "boolean"
        },
        "buy_add_package": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "entry_zone",
            "initial_position_pct",
            "target_position_pct",
            "max_position_pct",
            "thesis_break_triggers",
            "monitoring_triggers"
          ]
        }
      }
    },
    "thesis": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "INTACT",
            "WATCH",
            "BROKEN",
            "UNKNOWN"
          ]
        }
      }
    },
    "decision_upstream_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_version",
        "case_id",
        "cutoff_date",
        "reality_status",
        "quality_gate_status",
        "value_driver_status",
        "valuation_status",
        "forecast_status",
        "thesis_status",
        "thesis_admission_status",
        "capital_admission_ready",
        "quality_gate",
        "thesis_admission",
        "evidence_ids",
        "admission_record_hash"
      ],
      "properties": {
        "schema_version": {
          "const": "IIOS-CORE-04-UPSTREAM-ADMISSION-0.1"
        },
        "policy_version": {
          "const": "IIOS-DECISION-UPSTREAM-POLICY-0.1"
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "cutoff_date": {
          "type": "string",
          "format": "date"
        },
        "reality_status": {
          "enum": ["PASS", "CONDITIONAL", "UNKNOWN", "BLOCKED"]
        },
        "quality_gate_status": {
          "enum": ["PASS", "CONDITIONAL", "UNKNOWN", "BLOCKED"]
        },
        "value_driver_status": {
          "enum": ["PASS", "CONDITIONAL", "UNKNOWN", "BLOCKED"]
        },
        "valuation_status": {
          "enum": ["PASS", "CONDITIONAL", "UNKNOWN", "BLOCKED"]
        },
        "forecast_status": {
          "enum": ["PASS", "CONDITIONAL", "UNKNOWN", "BLOCKED"]
        },
        "thesis_status": {
          "enum": ["INTACT", "WATCH", "BROKEN", "UNKNOWN"]
        },
        "thesis_admission_status": {
          "enum": ["ADMITTED", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
        },
        "capital_admission_ready": {
          "type": "boolean"
        },
        "quality_gate": {
          "type": "object",
          "additionalProperties": true
        },
        "thesis_admission": {
          "type": "object",
          "additionalProperties": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "minItems": 1
        },
        "admission_record_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "return_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_price",
        "entry_value_reference",
        "horizon_years",
        "horizon_override",
        "horizon_override_basis",
        "horizon_selection_rationale",
        "buy_entry_return_cushion_threshold",
        "fundamental_target_annualized_return",
        "required_return_annualized",
        "scenarios"
      ],
      "properties": {
        "entry_price": {
          "type": [
            "string",
            "number"
          ]
        },
        "entry_value_reference": {
          "type": [
            "string",
            "number"
          ]
        },
        "horizon_years": {
          "type": "string",
          "pattern": "^(1|1\\.[0-9]+|2|2\\.[0-9]+|3)$"
        },
        "horizon_override": {
          "type": "boolean"
        },
        "horizon_override_basis": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "MAJOR_INDUSTRY_LEADER",
              "MAJOR_INVESTMENT_CYCLE_OR_MAJOR_CAPEX"
            ]
          }
        },
        "horizon_selection_rationale": {
          "type": "string",
          "minLength": 1
        },
        "buy_entry_return_cushion_threshold": {
          "type": [
            "string",
            "number"
          ]
        },
        "fundamental_target_annualized_return": {
          "type": [
            "string",
            "number"
          ]
        },
        "required_return_annualized": {
          "type": [
            "string",
            "number"
          ]
        },
        "scenarios": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bear",
            "base",
            "bull"
          ],
          "properties": {
            "bear": {
              "$ref": "#/$defs/scenario"
            },
            "base": {
              "$ref": "#/$defs/scenario"
            },
            "bull": {
              "$ref": "#/$defs/scenario"
            }
          }
        }
      }
    },
    "expectation_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "evaluator_version",
        "price",
        "price_observation_id",
        "cutoff_date",
        "mie_snapshot_hash",
        "market_expectation_id",
        "independent_forecast_ref"
      ],
      "properties": {
        "gap_id": {
          "type": "string",
          "minLength": 1
        },
        "evaluator_version": {
          "const": "IIOS-EXPECTATION-GAP-0.1"
        },
        "price": {
          "type": [
            "string",
            "number"
          ]
        },
        "price_observation_id": {
          "type": "string",
          "minLength": 1
        },
        "cutoff_date": {
          "type": "string",
          "format": "date"
        },
        "mie_snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "market_expectation_id": {
          "type": "string",
          "minLength": 1
        },
        "independent_forecast_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "forecast_id",
            "admission_record_hash"
          ],
          "properties": {
            "forecast_id": {
              "type": "string",
              "minLength": 1
            },
            "admission_record_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "decision_status",
        "investability_status",
        "primary_reason",
        "human_approval_required",
        "auto_execution"
      ],
      "properties": {
        "action": {
          "enum": [
            "BUY",
            "ADD",
            "HOLD",
            "REDUCE",
            "EXIT",
            "NO-BUY",
            "WATCH",
            "REVIEW_REQUIRED"
          ]
        },
        "decision_status": {
          "enum": [
            "READY",
            "BLOCKED",
            "REVIEW_REQUIRED",
            "SUPERSEDED"
          ]
        },
        "investability_status": {
          "enum": [
            "INVESTABLE",
            "WATCH",
            "NOT_INVESTABLE",
            "UNKNOWN"
          ]
        },
        "primary_reason": {
          "type": "string",
          "minLength": 1
        },
        "human_approval_required": {
          "const": true
        },
        "auto_execution": {
          "const": false
        },
        "current_price": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "target_entry_price": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "target_entry_price_semantics": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_entry_price_requires_gap_revalidation": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "target_entry_price_return_only": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "target_entry_price_v2_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_entry_price_v2": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "target_entry_price_gap_revalidation": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "target_entry_price_p2_1_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_entry_price_p2_1": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "target_entry_price_p2_1_price_response": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "position_package_complete": {
          "type": "boolean"
        },
        "canonical_entry_evaluation_version": {
          "anyOf": [
            { "const": null },
            { "const": "IIOS-P2.2-CANONICAL-ENTRY-EVALUATION-0.1" }
          ]
        },
        "canonical_entry_evaluation": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "decision_pre_admission_action": {
          "enum": ["BUY", "ADD", "HOLD", "REDUCE", "EXIT", "NO-BUY", "WATCH", "REVIEW_REQUIRED", null]
        },
        "decision_admission_version": {
          "anyOf": [
            { "const": null },
            { "const": "IIOS-P2.2-DECISION-ADMISSION-0.1" }
          ]
        },
        "decision_admission": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "decision_admission_status": {
          "type": ["string", "null"]
        },
        "decision_admission_rule_id": {
          "type": ["string", "null"]
        },
        "decision_precedence_version": {
          "const": "IIOS-DECISION-PRECEDENCE-0.1"
        },
        "decision_precedence_rule_id": {
          "type": "string",
          "minLength": 1
        },
        "decision_precedence_rank": {
          "type": "integer",
          "minimum": 0
        },
        "decision_scope": {
          "enum": [
            "UNIVERSAL",
            "EXISTING_POSITION",
            "NEW_CAPITAL"
          ]
        },
        "capital_effect": {
          "enum": [
            "INCREASE",
            "UNCHANGED",
            "DECREASE",
            "REVIEW"
          ]
        },
        "expectation_gap_evaluation": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "evaluation_version",
            "evaluation_id",
            "evaluation_hash",
            "case_id",
            "cutoff_date",
            "price",
            "price_observation_id",
            "mie_snapshot_hash",
            "mie_set_hash",
            "provenance_hash",
            "market_expectation_id",
            "independent_forecast_ref",
            "independent_forecast_id",
            "independent_forecast_version",
            "independent_forecast_model_version",
            "status",
            "resolution_state",
            "qualification",
            "comparison",
            "independent_value",
            "market_required_value",
            "gap_absolute",
            "gap_relative",
            "reason",
            "policy_effect",
            "evidence_ids"
          ],
          "properties": {
            "evaluation_version": {
              "const": "IIOS-C4-EXPECTATION-GAP-0.1"
            },
            "evaluation_id": {
              "type": "string",
              "minLength": 1
            },
            "evaluation_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "case_id": {
              "type": "string",
              "minLength": 1
            },
            "cutoff_date": {
              "type": "string",
              "format": "date"
            },
            "price": {
              "type": "string"
            },
            "price_observation_id": {
              "type": "string",
              "minLength": 1
            },
            "mie_snapshot_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "mie_set_hash": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "provenance_hash": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "market_expectation_id": {
              "type": "string",
              "minLength": 1
            },
            "independent_forecast_ref": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "forecast_id",
                "admission_record_hash"
              ],
              "properties": {
                "forecast_id": {
                  "type": "string",
                  "minLength": 1
                },
                "admission_record_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "independent_forecast_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "independent_forecast_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "independent_forecast_model_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "PASS",
                "BLOCKED",
                "AMBIGUOUS",
                "INCOMPATIBLE",
                "NO_FEASIBLE_SOLUTION"
              ]
            },
            "resolution_state": {
              "type": [
                "string",
                "null"
              ]
            },
            "qualification": {
              "type": [
                "string",
                "null"
              ]
            },
            "comparison": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "variable_id",
                "unit",
                "basis",
                "horizon_years",
                "comparison_direction"
              ],
              "properties": {
                "variable_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "basis": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "horizon_years": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "comparison_direction": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "HIGHER_IS_BETTER",
                    "LOWER_IS_BETTER",
                    null
                  ]
                }
              }
            },
            "independent_value": {
              "type": [
                "string",
                "null"
              ]
            },
            "market_required_value": {
              "type": [
                "string",
                "null"
              ]
            },
            "gap_absolute": {
              "type": [
                "string",
                "null"
              ]
            },
            "gap_relative": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "policy_effect": {
              "const": "ADVISORY_ONLY_NO_ADDITIVE_RETURN_THRESHOLD"
            },
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "target_entry_price_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_expectation_id",
        "independent_forecast_ref"
      ],
      "properties": {
        "market_expectation_id": {
          "type": "string",
          "minLength": 1
        },
        "independent_forecast_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "forecast_id",
            "admission_record_hash"
          ],
          "properties": {
            "forecast_id": {
              "type": "string",
              "minLength": 1
            },
            "admission_record_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "market_implied_expectation_snapshot_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_type",
        "root_id",
        "content_sha256"
      ],
      "properties": {
        "root_type": {
          "const": "P4F_MIE_SNAPSHOT"
        },
        "root_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probability",
        "terminal_value_per_share",
        "cash_distributions_per_share",
        "probability_rationale"
      ],
      "properties": {
        "probability": {
          "type": [
            "string",
            "number"
          ]
        },
        "terminal_value_per_share": {
          "type": [
            "string",
            "number"
          ]
        },
        "cash_distributions_per_share": {
          "type": [
            "string",
            "number"
          ]
        },
        "probability_rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "expectation_gap"
        ]
      },
      "then": {
        "required": [
          "market_implied_expectation_snapshot_ref"
        ]
      }
    },
    {
      "if": {
        "required": [
          "target_entry_price_reference"
        ]
      },
      "then": {
        "required": [
          "market_implied_expectation_snapshot_ref"
        ]
      }
    },
    {
      "not": {
        "required": [
          "expectation_gap",
          "target_entry_price_reference"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "return_gate": {
            "properties": {
              "horizon_years": {
                "const": "3"
              }
            },
            "required": [
              "horizon_years"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "return_gate": {
            "properties": {
              "horizon_override": {
                "const": true
              },
