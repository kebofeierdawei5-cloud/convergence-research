        "adjustment_semantics": {
          "enum": [
            "UNADJUSTED",
            "SPLIT_ADJUSTED",
            "DIVIDEND_ADJUSTED",
            "TOTAL_RETURN_ADJUSTED",
            "OTHER_EXPLICIT"
          ]
        },
        "adjustment_note": {
          "type": "string"
        },
        "price_observation_admission_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "company_evidence_manifest": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "manifest_id"
      ],
      "properties": {
        "manifest_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
