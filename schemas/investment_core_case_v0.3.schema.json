              "maxItems": 2,
              "items": {
                "type": "string"
              }
            },
            "add_zone": {
              "type": [
                "array",
                "null"
              ],
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string"
              }
            },
            "reduce_zone": {
              "type": [
                "array",
                "null"
              ],
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
