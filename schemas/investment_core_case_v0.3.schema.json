      "type": "object",
      "additionalProperties": false,
      "required": [
        "price",
        "price_observation_id",
        "currency",
        "observed_at",
        "known_at",
        "source",
        "adjustment_semantics",
        "price_observation_admission_hash"
      ],
      "properties": {
        "price": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "price_observation_id": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "minLength": 1
        },
        "known_at": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
