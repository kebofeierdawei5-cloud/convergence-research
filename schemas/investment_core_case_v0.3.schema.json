{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iios.local/schemas/investment-core-case-0.3.schema.json",
  "title": "IIOS Investment Core Case v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "case_id",
    "market",
    "symbol",
    "company",
    "as_of_date",
    "cutoff_date",
    "current_price_observation",
    "company_evidence_manifest",
    "trust",
    "reality",
    "forecast",
    "valuation",
    "risk",
    "portfolio",
    "thesis",
