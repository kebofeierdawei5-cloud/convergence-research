      "properties": {
        "status": {
          "enum": [
            "PASS",
            "REVALIDATION",
            "FAIL",
            "UNKNOWN"
          ]
        }
      }
    },
    "reality": {
      "type": "object"
    },
    "forecast": {
      "type": "object"
    },
    "valuation": {
      "type": "object"
    },
