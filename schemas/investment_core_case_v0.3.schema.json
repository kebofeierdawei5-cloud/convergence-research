        "quality_gate_status": {
          "enum": [
            "PASS",
            "CONDITIONAL",
            "UNKNOWN",
            "BLOCKED"
          ]
        },
        "value_driver_status": {
          "enum": [
            "PASS",
            "CONDITIONAL",
            "UNKNOWN",
            "BLOCKED"
          ]
        },
        "valuation_status": {
          "enum": [
            "PASS",
            "CONDITIONAL",
            "UNKNOWN",
            "BLOCKED"
          ]
        },
        "forecast_status": {
          "enum": [
            "PASS",
            "CONDITIONAL",
            "UNKNOWN",
            "BLOCKED"
          ]
        },
        "thesis_status": {
          "enum": [
            "INTACT",
            "WATCH",
            "BROKEN",
            "UNKNOWN"
