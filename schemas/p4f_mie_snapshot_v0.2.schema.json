{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iios.local/schemas/p4f-mie-snapshot-0.2.schema.json",
  "title": "IIOS P4-F Market Implied Expectation PIT/Replay Snapshot v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_schema",
    "p4f_version",
    "case_id",
    "cutoff_date",
    "created_at",
    "mie_set",
    "provenance_manifest",
    "mie_set_hash",
    "provenance_hash",
    "snapshot_hash"
  ],
  "properties": {
    "snapshot_schema": {
      "const": "IIOS-MIE-SNAPSHOT-0.2"
    },
    "p4f_version": {
      "const": "P4-F-0.2"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "cutoff_date": {
      "type": "string",
      "format": "date"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "mie_set": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "set_id",
        "candidate_coverage",
        "evidence_sufficiency",
        "model_evaluations",
        "resolution_state",
        "qualification",
        "qualification_rationale",
        "evidence_ids"
      ]
    },
    "provenance_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "variable",
          "unit",
          "basis",
          "observation_date",
          "known_at",
          "source",
          "source_location",
          "content_sha256",
          "captured_at"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "variable": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "observation_date": {
            "type": "string",
            "format": "date"
          },
          "known_at": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "source_location": {
            "type": "string",
            "minLength": 1
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "captured_at": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mie_set_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mie_set": {
            "required": [
              "qualification"
            ]
          },
          "provenance_manifest": {
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "snapshot_hash": {
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
