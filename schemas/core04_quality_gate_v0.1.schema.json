{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iios.local/schemas/core04-quality-gate-0.1.schema.json",
  "title": "IIOS CORE-04 Quality Gate v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "policy",
    "case_id",
    "cutoff_date",
    "status",
    "capital_admission_pass",
    "dimensions",
    "blocking_dimensions",
    "quality_gate_id",
    "admission_record_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "IIOS-CORE-04-QUALITY-GATE-0.1"
    },
    "policy_version": {
      "const": "IIOS-QUALITY-GATE-POLICY-0.1"
    },
    "policy": {
      "const": "ALL_CORE_DIMENSIONS_PASS_FOR_NEW_CAPITAL"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "cutoff_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "PASS",
        "CONDITIONAL",
        "UNKNOWN",
        "BLOCKED"
      ]
    },
    "capital_admission_pass": {
      "type": "boolean"
    },
    "dimensions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "status",
          "rationale",
          "evidence_ids"
        ],
        "properties": {
          "dimension": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "CONDITIONAL",
              "UNKNOWN",
              "BLOCKED"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "blocking_dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "quality_gate_id": {
      "type": "string",
      "minLength": 1
    },
    "admission_record_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
