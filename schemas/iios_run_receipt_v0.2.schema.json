{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iios.local/schemas/iios-run-receipt-v0.2.schema.json",
  "title": "IIOS Canonical Run Receipt v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "market",
    "symbol",
    "cutoff_date",
    "as_of_date",
    "orchestrator_version",
    "research_case_hash",
    "raw_request_sha256",
    "request_receipt_hash",
    "normalized_request_sha256",
    "stage_receipt_hashes",
    "stage_chain_hash",
    "evidence_manifest_hash",
    "semantic_artifact_hashes",
    "forecast_admission_hash",
    "valuation_admission_hash",
    "return_hash",
    "risk_portfolio_hash",
    "decision_admission_hash",
    "decision_revision",
    "publication_hash",
    "report_hash",
    "run_status",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "IIOS-RUN-RECEIPT-0.2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "market": {
      "enum": [
        "CN-A",
        "HK"
      ]
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "cutoff_date": {
      "type": "string",
      "format": "date"
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "orchestrator_version": {
      "type": "string",
      "minLength": 1
    },
    "research_case_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_receipt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "normalized_request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stage_receipt_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "stage_chain_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semantic_artifact_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "forecast_admission_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "valuation_admission_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "return_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "risk_portfolio_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision_admission_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision_revision": {
      "type": "integer",
      "minimum": 1
    },
    "publication_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "report_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_status": {
      "const": "COMPLETE"
    },
    "receipt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
