{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iios.local/schemas/monitoring-initialization-0.1.schema.json",
  "title": "IIOS Monitoring Initialization v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "initialization_version","initialization_id","trigger_id","trigger_hash",
    "decision_id","decision_series_id","revision","decision_revision_hash",
    "case_id","monitor_id","initial_state_hash","initial_state","initialization_hash"
  ],
  "properties": {
    "initialization_version": {"const": "IIOS-MONITORING-INITIALIZATION-0.1"},
    "initialization_id": {"type": "string","minLength": 1},
    "trigger_id": {"type": "string","minLength": 1},
    "trigger_hash": {"type": "string","pattern": "^[0-9a-f]{64}$"},
    "decision_id": {"type": "string","minLength": 1},
    "decision_series_id": {"type": "string","minLength": 1},
    "revision": {"type": "integer","minimum": 1},
    "decision_revision_hash": {"type": "string","pattern": "^[0-9a-f]{64}$"},
    "case_id": {"type": "string","minLength": 1},
    "monitor_id": {"type": "string","minLength": 1},
    "initial_state_hash": {"type": "string","pattern": "^[0-9a-f]{64}$"},
    "initial_state": {"$ref": "monitoring_state_v0.1.schema.json"},
    "initialization_hash": {"type": "string","pattern": "^[0-9a-f]{64}$"}
  }
}
