{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iios.local/schemas/company-capital-trust-bridge-0.1.schema.json",
  "title": "IIOS Company Capital Trust Bridge v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "cutoff_date",
    "observation_date",
    "evidence_admission",
    "capital_allocation",
    "trust_revalidation",
    "decision_effect",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "IIOS-COMPANY-CAPITAL-TRUST-BRIDGE-0.1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "cutoff_date": {
      "type": "string",
      "minLength": 1
    },
    "observation_date": {
      "type": "string",
      "format": "date"
    },
    "evidence_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence_ids",
        "sha256"
      ],
      "properties": {
        "status": {
          "const": "ADMITTED"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "capital_allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "shareholder_return",
        "capital_commitments",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "CONDITIONAL"
        },
        "shareholder_return": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "annual_2025_payout_ratio",
            "h1_2026_interim_payout_ratio",
            "h1_2026_repurchase_share_ratio"
          ],
          "properties": {
            "status": {
              "const": "ESTABLISHED"
            },
            "annual_2025_payout_ratio": {
              "type": "number",
              "minimum": 0
            },
            "h1_2026_interim_payout_ratio": {
              "type": "number",
              "minimum": 0
            },
            "h1_2026_repurchase_share_ratio": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "capital_commitments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "indonesia_planned_investment_usd",
            "related_party_guarantee_cap_usd",
            "guarantee_to_project_ratio",
            "related_party_procurement_cap_usd"
          ],
          "properties": {
            "status": {
              "const": "CONDITIONAL"
            },
            "indonesia_planned_investment_usd": {
              "type": "number",
              "minimum": 0
            },
            "related_party_guarantee_cap_usd": {
              "type": "number",
              "minimum": 0
            },
            "guarantee_to_project_ratio": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "related_party_procurement_cap_usd": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trust_revalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "governance_integrity",
        "shareholder_treatment",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "CONDITIONAL"
        },
        "governance_integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "related_party_transactions_or_exposures_present",
            "independent_director_review",
            "related_director_recusal",
            "non_related_director_vote_control"
          ],
          "properties": {
            "status": {
              "const": "CONDITIONAL"
            },
            "related_party_transactions_or_exposures_present": {
              "const": true
            },
            "independent_director_review": {
              "const": true
            },
            "related_director_recusal": {
              "const": true
            },
            "non_related_director_vote_control": {
              "const": true
            }
          }
        },
        "shareholder_treatment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "basis"
          ],
          "properties": {
            "status": {
              "const": "PASS"
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision_effect": {
      "const": "NO_DIRECT_GATE_EFFECT"
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_sha256",
        "bridge_sha256"
      ],
      "properties": {
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bridge_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
