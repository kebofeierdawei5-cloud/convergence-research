{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iios.local/schemas/investment-core-case-0.2.schema.json",
  "title": "IIOS Investment Core Case v0.2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract_version",
    "case_id",
    "market",
    "symbol",
    "company",
    "as_of_date",
    "cutoff_date",
    "current_price_observation",
    "trust",
    "reality",
    "forecast",
    "valuation",
    "market_implied_expectation",
    "expectation_gap",
    "return_gate",
    "risk",
    "portfolio",
    "thesis",
    "decision"
  ],
  "properties": {
    "contract_version": {
      "const": "IIOS-INVESTMENT-CORE-0.2"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "market": {
      "type": "string",
      "minLength": 1
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "company": {
      "type": "string",
      "minLength": 1
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "cutoff_date": {
      "type": "string",
      "format": "date"
    },
    "current_price_observation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "price",
        "currency",
        "observed_at",
        "known_at",
        "source",
        "adjustment_semantics"
      ],
      "properties": {
        "price": {
          "type": [
            "number",
            "string"
          ]
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string"
        },
        "known_at": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "adjustment_semantics": {
          "enum": [
            "UNADJUSTED",
            "SPLIT_ADJUSTED",
            "DIVIDEND_ADJUSTED",
            "TOTAL_RETURN_ADJUSTED",
            "OTHER_EXPLICIT"
          ]
        }
      }
    },
    "trust": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "REVALIDATION",
            "FAIL",
            "UNKNOWN"
          ]
        }
      }
    },
    "thesis": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "INTACT",
            "WATCH",
            "BROKEN",
            "UNKNOWN"
          ]
        }
      }
    },
    "market_implied_expectation": {
      "type": "object",
      "required": [
        "market_model",
        "identifiability",
        "stability",
        "economic_variables",
        "observation_basis",
        "assumption_set",
        "evidence_sufficiency"
      ],
      "properties": {
        "market_model": {
          "type": "string",
          "minLength": 1
        },
        "identifiability": {
          "enum": [
            "IDENTIFIABLE",
            "AMBIGUOUS",
            "UNIDENTIFIABLE",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "stability": {
          "enum": [
            "STABLE",
            "UNSTABLE",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "economic_variables": {
          "type": "array",
          "minItems": 1
        },
        "observation_basis": {
          "type": "object"
        },
        "assumption_set": {
          "type": "object"
        },
        "evidence_sufficiency": {
          "type": "boolean"
        }
      }
    },
    "return_gate": {
      "type": "object",
      "required": [
        "entry_price",
        "scenario_values",
        "scenarios",
        "expected_value",
        "expected_return_pct",
        "hurdle_pct",
        "hurdle_pass"
      ],
      "properties": {
        "entry_price": {
          "type": [
            "number",
            "string"
          ]
        },
        "scenario_values": {
          "type": "object",
          "required": [
            "bear",
            "base",
            "bull"
          ]
        },
        "scenarios": {
          "type": "object",
          "required": [
            "bear",
            "base",
            "bull"
          ]
        },
        "expected_value": {
          "type": [
            "number",
            "string"
          ]
        },
        "expected_return_pct": {
          "type": [
            "number",
            "string"
          ]
        },
        "hurdle_pct": {
          "const": 15
        },
        "hurdle_pass": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "enum": [
            "BUY",
            "ADD",
            "HOLD",
            "REDUCE",
            "EXIT",
            "NO-BUY"
          ]
        }
      }
    }
  }
}
