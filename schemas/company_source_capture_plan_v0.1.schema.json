{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iios.local/schemas/company-source-capture-plan-0.1.schema.json",
  "title": "IIOS Company Source Capture Plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","case_id","market","symbol","company","cutoff_date","purpose","capture_requirements","plan_status","audit"],
  "properties": {
    "schema_version": {"const":"IIOS-COMPANY-SOURCE-CAPTURE-PLAN-0.1"},
    "case_id": {"type":"string","minLength":1},
    "market": {"enum":["CN-A","HK"]},
    "symbol": {"type":"string","minLength":1},
    "company": {"type":"string","minLength":1},
    "cutoff_date": {"type":"string","minLength":10},
    "purpose": {"type":"string","minLength":1},
    "capture_requirements": {
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["capture_id","field_groups","source_ref","source_locator","pit_basis","required","exact_bytes_required","status"],
        "properties":{
          "capture_id":{"type":"string","minLength":1},
          "field_groups":{
            "type":"array","minItems":1,"uniqueItems":true,
            "items":{"enum":["security_identity","market_price","corporate_disclosures","business_reality","financial_reality","capital_structure","trust_governance_events"]}
          },
          "source_ref":{"type":"string","minLength":1},
          "source_locator":{"type":"string","minLength":1},
          "pit_basis":{"enum":["SOURCE_VINTAGE","EVENT_PUBLICATION","TRADE_DATE"]},
          "required":{"type":"boolean"},
          "exact_bytes_required":{"const":true},
          "status":{"const":"PENDING_RAW"},
          "notes":{"type":"string"}
        }
      }
    },
    "plan_status":{"const":"BLOCKED_PENDING_RAW"},
    "audit":{
      "type":"object","additionalProperties":false,
      "required":["plan_sha256"],
      "properties":{"plan_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
    }
  }
}