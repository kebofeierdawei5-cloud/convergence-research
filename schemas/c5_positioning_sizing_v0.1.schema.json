{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iios.local/schemas/c5-positioning-sizing-0.1.schema.json",
  "title": "IIOS C5 Positioning / Sizing Production Contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluation_version",
    "evaluation_id",
    "evaluation_hash",
    "policy_version",
    "case_id",
    "cutoff_date",
    "observation_id",
    "observation_as_of_date",
    "known_at",
    "source",
    "source_bundle_sha256",
    "evidence_ids",
    "factors",
    "factor_scores",
    "composite_score",
    "timing_bias",
    "sizing_band",
    "sizing_permission",
    "current_position_pct",
    "initial_position_pct",
    "target_position_pct",
    "max_position_pct",
    "permitted_position_pct",
    "reduce_consideration",
    "status",
    "reason",
    "policy_effect"
  ],
  "properties": {
    "evaluation_version": {
      "const": "IIOS-C5-POSITIONING-SIZING-0.1"
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_version": {
      "const": "IIOS-C5-POSITIONING-POLICY-0.1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "cutoff_date": {
      "type": "string",
      "format": "date"
    },
    "observation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "observation_as_of_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "known_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_bundle_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "factors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_regime",
        "industry_sentiment",
        "stock_structure",
        "holder_capital_structure",
        "crowding_supply_pressure"
      ],
      "properties": {
        "market_regime": {
          "type": [
            "string",
            "null"
          ]
        },
        "industry_sentiment": {
          "type": [
            "string",
            "null"
          ]
        },
        "stock_structure": {
          "type": [
            "string",
            "null"
          ]
        },
        "holder_capital_structure": {
          "type": [
            "string",
            "null"
          ]
        },
        "crowding_supply_pressure": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "factor_scores": {
      "type": "object",
      "additionalProperties": false
    },
    "composite_score": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": -5,
      "maximum": 5
    },
    "timing_bias": {
      "enum": [
        "FAVORABLE",
        "NEUTRAL",
        "UNFAVORABLE",
        null
      ]
    },
    "sizing_band": {
      "enum": [
        "TARGET",
        "INITIAL",
        "CURRENT",
        "NONE"
      ]
    },
    "sizing_permission": {
      "enum": [
        "ALLOW_UP_TO_TARGET",
        "ALLOW_UP_TO_INITIAL",
        "HOLD_CURRENT_NO_ADD",
        "NO_SIZING_PERMISSION"
      ]
    },
    "current_position_pct": {
      "type": [
        "string",
        "null"
      ]
    },
    "initial_position_pct": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_position_pct": {
      "type": [
        "string",
        "null"
      ]
    },
    "max_position_pct": {
      "type": [
        "string",
        "null"
      ]
    },
    "permitted_position_pct": {
      "type": [
        "string",
        "null"
      ]
    },
    "reduce_consideration": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "PASS",
        "BLOCKED"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "policy_effect": {
      "const": "TIMING_AND_SIZING_ONLY_NO_FUNDAMENTAL_DECISION_MUTATION"
    }
  }
}
