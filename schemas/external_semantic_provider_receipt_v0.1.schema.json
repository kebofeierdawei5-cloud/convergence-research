{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iios.local/schemas/external-semantic-provider-receipt-0.1.schema.json",
  "title": "IIOS External Signed Semantic Provider Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version","attestation_id","request_id","run_id","raw_request_sha256","case_id","cutoff_date",
    "producer_type","producer_id","producer_version","policy_version","artifact_hash","input_refs",
    "input_hashes","public_key_id","signature_algorithm","signature_b64","status","created_at","attestation_hash"
  ],
  "properties": {
    "schema_version":{"const":"IIOS-EXTERNAL-SEMANTIC-PROVIDER-RECEIPT-0.1"},
    "attestation_id":{"type":"string","minLength":1},
    "request_id":{"type":"string","minLength":1},
    "run_id":{"type":"string","minLength":1},
    "raw_request_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "case_id":{"type":"string","minLength":1},
    "cutoff_date":{"type":"string","format":"date"},
    "producer_type":{"const":"LLM_SEMANTIC_PRODUCER"},
    "producer_id":{"type":"string","minLength":1},
    "producer_version":{"type":"string","minLength":1},
    "policy_version":{"type":"string","minLength":1},
    "artifact_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "input_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "input_hashes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "public_key_id":{"type":"string","minLength":1},
    "signature_algorithm":{"const":"Ed25519"},
    "signature_b64":{"type":"string","minLength":1},
    "status":{"const":"SIGNED"},
    "created_at":{"type":"string","format":"date-time"},
    "attestation_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
