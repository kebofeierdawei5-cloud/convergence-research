{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://iios.local/schema/evaluation-purity-boundary-0.1.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","boundary_id","version","status","allowed_visibility","forbidden_inputs","outer_result_firewall","contamination_rule"],
  "properties":{
    "schema_version":{"const":"IIOS-EVALUATION-PURITY-BOUNDARY-0.1"},
    "boundary_id":{"type":"string","pattern":"^EPB-[A-Z0-9_-]+$"},
    "version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "status":{"enum":["DRAFT","FROZEN","SUPERSEDED","INVALID"]},
    "allowed_visibility":{"enum":["DEVELOPMENT_ONLY","DESCRIPTIVE_ONLY","CONFIRMATORY","PRODUCTION"]},
    "forbidden_inputs":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},
    "outer_result_firewall":{"const":"OUTER_RESULTS_CANNOT_FLOW_BACK_INTO_SAME_EPOCH_TUNING"},
    "contamination_rule":{"const":"EXPOSURE_INHERITS_FORWARD_AND_CANNOT_BE_WASHED_BY_NEW_EPOCH_ID"}
  }
}
