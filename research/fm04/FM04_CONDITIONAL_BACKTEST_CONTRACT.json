    {"target_id": "CATL_NET_PROFIT", "driver_id": "NET_PROFIT"}
  ],
  "models": [
    {
      "model_id": "SEASONAL_NAIVE",
      "order": 1,
      "formula": "forecast(t+h) = x(t+h-4)",
      "required_visible_periods": "target_period_minus_4",
      "uses_current_origin_value": false
    },
    {
      "model_id": "PERSISTENCE_YOY",
      "order": 2,
      "formula": "forecast(t+h) = x(t+h-4) * (1 + yoy_growth(t))",
      "required_visible_periods": "target_period_minus_4_and_t_and_t_minus_4",
      "uses_current_origin_value": true
    },
    {
      "model_id": "TREND_LOG_LINEAR_8Q",
      "order": 3,
      "formula": "fit OLS log(x) on the latest 8 visible quarters ending at t; forecast at t+h",
      "required_visible_periods": "t_minus_7_through_t",
      "uses_current_origin_value": true
    },
    {
      "model_id": "MEAN_REVERSION_YOY_8",
      "order": 4,
      "formula": "forecast(t+h) = x(t+h-4) * (1 + mean(last_8_visible_yoy_growth_values_ending_at_t))",
      "required_visible_periods": "t_minus_11_through_t",
      "uses_current_origin_value": true
    }
  ],
  "evaluation": {
    "primary_metric": "MAE",
    "secondary_metrics": ["RMSE", "sMAPE"],
    "pairwise_comparison_rule": "SAME_ORIGIN_UNIVERSE_SAME_TARGET_SAME_HORIZON_SAME_ACTUAL",
    "rolling_origins_assumed_iid": false,
    "significance_claim_allowed": false,
